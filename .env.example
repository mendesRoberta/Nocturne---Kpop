# ==============================================================================
# NOCTURNE — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha suas chaves.
# ==============================================================================

# Google Gemini API (SERVER-ONLY — NUNCA use o prefixo NEXT_PUBLIC_ aqui!)
# Obtenha sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui

# Supabase Configuration (Opcional caso utilize apenas o Modo Demo/Visitante)
# Obtenha no painel do Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
